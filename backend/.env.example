# ==========================================
# NER-SHIELD BACKEND CONFIGURATION
# ==========================================

# Application
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=nershield_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication (JWT)
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRATION=3600s

# AI Service (Prediction Engine)
AI_SERVICE_URL=http://localhost:8000/api/v1/predict

# External APIs
WEATHER_API_KEY=your_weather_api_key
GIS_PROVIDER_URL=https://api.mapbox.com
STORAGE_BUCKET=nershield-assets
NOTIFICATION_PROVIDER_KEY=your_twilio_or_sendgrid_key
